# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Connection (Server-only — NEVER prefix with NEXT_PUBLIC_ and NEVER commit real values)
# Supports Neon PostgreSQL (postgresql://) OR MySQL / MariaDB (mysql://, mysql2://, mariadb://)
# Leave as placeholder to run in zero-config in-memory demo mode:
DATABASE_URL="YOUR_NEON_DATABASE_URL"

# Direct (unpooled) connection string used by Prisma CLI migrations & schema commands (required for Neon PostgreSQL):
DIRECT_URL="YOUR_NEON_DIRECT_DATABASE_URL"
