  breakfastEnabled           Boolean             @default(true) @map("breakfast_enabled")
  lunchEnabled               Boolean             @default(true) @map("lunch_enabled")
  dinnerEnabled              Boolean             @default(true) @map("dinner_enabled")
  breakfastWeight            Decimal             @default(0.5) @db.Decimal(5, 2) @map("breakfast_weight")
  lunchWeight                Decimal             @default(1.0) @db.Decimal(5, 2) @map("lunch_weight")
  dinnerWeight               Decimal             @default(1.0) @db.Decimal(5, 2) @map("dinner_weight")
  breakfastCutoff            String              @default("06:00") @map("breakfast_cutoff")
  lunchCutoff                String              @default("09:00") @map("lunch_cutoff")
  dinnerCutoff               String              @default("16:00") @map("dinner_cutoff")
  defaultCutoffTime          String              @default("20:00") @map("default_cutoff_time")
  autoApproveMealOff         Boolean             @default(true) @map("auto_approve_meal_off")
