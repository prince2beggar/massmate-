// MessMate — Multi-Tenant SaaS Database Schema
// Task 19 & Task 20: Core Schema & User-Tenant-Membership Relationships

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
}

enum TenantType {
  STUDENT_MESS
  BACHELOR_MESS
  HOSTEL
  SHARED_APARTMENT
  OTHER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
}

enum RoleStatus {
  ACTIVE
  ARCHIVED
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  SUPPORT_STAFF
  FINANCE_STAFF
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
}

enum VerificationDocumentType {
  TRADE_LICENSE
  NATIONAL_ID
  UTILITY_BILL
  RENTAL_AGREEMENT
  OTHER
}

enum PlanType {
  STARTER
  CUSTOM_BUSINESS
  ENTERPRISE
  STANDARD
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum TrialStatus {
  NOT_STARTED
  ACTIVE
  EXPIRED
  CONVERTED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REJECTED
  REFUNDED
  PARTIALLY_PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BKASH
  NAGAD
  ROCKET
  ONLINE_GATEWAY
  OTHER
}

enum InquiryStatus {
  NEW
  REVIEWING
  PROPOSAL_SENT
  NEGOTIATION
  APPROVED
  REJECTED
  CLOSED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM_DOMAIN
}

enum DomainVerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum DnsStatus {
  PENDING_CONFIGURATION
  CONFIGURED
  FAILED
}

enum SslStatus {
  NOT_CONFIGURED
  PENDING
  ACTIVE
  FAILED
  EXPIRED
}

enum DomainStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  REMOVED
}

enum SupportTicketCategory {
  ACCOUNT_LOGIN
  SUBSCRIPTION_BILLING
  DOMAIN_WEBSITE
  TECHNICAL_ISSUE
  FEATURE_REQUEST
  GENERAL_INQUIRY
  OTHER
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum NotificationType {
  NEW_TENANT
  TRIAL_EXPIRING
  PENDING_PAYMENT
  DOMAIN_REQUEST
  SUPPORT_TICKET_NEW
  SUPPORT_TICKET_REPLY
  SUPPORT_TICKET_URGENT
  SYSTEM_ALERT
}

// -----------------------------------------------------------------------------
// USER (Platform-wide Identity)
// -----------------------------------------------------------------------------

model User {
  id              String      @id @default(cuid())
  name            String
  email           String?     @unique
  phone           String?     @unique
  passwordHash    String?
  profileImage    String?
  status          UserStatus    @default(ACTIVE)
  platformRole    PlatformRole?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships           Membership[]
  auditLogs             AuditLog[]
  reviewedVerifications TenantVerification[]
  approvedSubscriptions Subscription[]        @relation("ApprovedSubscriptions")
  confirmedInvoices     SubscriptionInvoice[] @relation("ConfirmedInvoices")
  assignedInquiries     CustomPlanInquiry[]   @relation("AssignedInquiries")
  preparedQuotations    CustomQuotation[]     @relation("PreparedQuotations")
  approvedQuotations    CustomQuotation[]     @relation("ApprovedQuotations")
  requestedTickets      SupportTicket[]       @relation("RequesterTickets")
  assignedTickets       SupportTicket[]       @relation("AssignedTickets")
  ticketMessages        SupportTicketMessage[]
  notifications         PlatformNotification[]

  @@index([status])
  @@index([platformRole])
  @@index([createdAt])
  @@map("users")
}

// -----------------------------------------------------------------------------
// TENANT / MESS (Independent Organization)
// -----------------------------------------------------------------------------

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  description        String?
  logo               String?
  coverImage         String?
  email              String?
  phone              String?
  address            String?
  city               String?
  country            String              @default("Bangladesh")
  timezone           String              @default("Asia/Dhaka")
  tenantType         TenantType          @default(BACHELOR_MESS)
  status             TenantStatus        @default(ACTIVE)
  verificationStatus VerificationStatus  @default(NOT_SUBMITTED)
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  memberships  Membership[]
  roles        Role[]
  auditLogs    AuditLog[]
  verification TenantVerification?
  subscription Subscription?
  invoices     SubscriptionInvoice[]
  domains      Domain[]
  supportTickets SupportTicket[]

  @@index([status])
  @@index([verificationStatus])
  @@index([tenantType])
  @@index([city])
  @@map("tenants")
}

// -----------------------------------------------------------------------------
// TENANT VERIFICATION (Restricted Identity & Compliance Documentation)
// -----------------------------------------------------------------------------

model TenantVerification {
  id              String                    @id @default(cuid())
  tenantId        String                    @unique
  status          VerificationStatus        @default(NOT_SUBMITTED)
  documentType    VerificationDocumentType?
  documentNumber  String?                   // Masked/redacted document number
  documentFileUrl String?                   // Private internal storage path (never public)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewerUserId  String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewer User?  @relation(fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@map("tenant_verifications")
}

// -----------------------------------------------------------------------------
// ROLE (Tenant-Scoped Roles)
// -----------------------------------------------------------------------------

model Role {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  isSystem    Boolean     @default(false)
  status      RoleStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("roles")
}

// -----------------------------------------------------------------------------
// ROLE TEMPLATE (Platform-Level System Role Blueprints)
// -----------------------------------------------------------------------------

model RoleTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RoleTemplatePermission[]

  @@map("role_templates")
}

// -----------------------------------------------------------------------------
// PERMISSION (Granular Capability Definition)
// -----------------------------------------------------------------------------

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions     RolePermission[]
  templatePermissions RoleTemplatePermission[]

  @@index([module])
  @@map("permissions")
}

// -----------------------------------------------------------------------------
// ROLE PERMISSION (Junction: Tenant Role <-> Permission)
// -----------------------------------------------------------------------------

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// ROLE TEMPLATE PERMISSION (Junction: Role Template <-> Permission)
// -----------------------------------------------------------------------------

model RoleTemplatePermission {
  id           String   @id @default(cuid())
  templateId   String
  permissionId String
  createdAt    DateTime @default(now())

  template   RoleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  permission Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([templateId, permissionId])
  @@index([templateId])
  @@index([permissionId])
  @@map("role_template_permissions")
}

// -----------------------------------------------------------------------------
// MEMBERSHIP (User <-> Tenant Association)
// -----------------------------------------------------------------------------

model Membership {
  id                    String           @id @default(cuid())
  userId                String
  tenantId              String
  roleId                String
  status                MembershipStatus @default(ACTIVE)
  memberCode            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  joinedAt              DateTime?
  invitedAt             DateTime?
  leftAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@index([status])
  @@index([tenantId, status])
  @@map("memberships")
}

// -----------------------------------------------------------------------------
// AUDIT LOG (Append-Only Event Ledger)
// -----------------------------------------------------------------------------

model AuditLog {
  id                String   @id @default(cuid())
  tenantId          String?  // Nullable for platform-level governance events
  actorUserId       String?  // Global user ID who performed the action
  actorMembershipId String?  // Specific membership context if tenant-scoped
  action            String   // e.g. "member.create", "role.update", "tenant.suspend"
  entityType        String   // e.g. "membership", "role", "tenant", "user"
  entityId          String?  // Primary key of affected entity
  description       String?  // Human-readable audit narrative
  beforeData        Json?    // State before mutation
  afterData         Json?    // State after mutation
  metadata          Json?    // Contextual metadata (route, correlationId, userAgent)
  ipAddress         String?  // Client IP (sanitized/redacted)
  createdAt         DateTime @default(now())

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTION PLAN (Configurable SaaS Packages)
// -----------------------------------------------------------------------------

model Plan {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String?
  planType        PlanType        @default(STARTER)
  priceMonthly    Decimal         @default(99.00) @db.Decimal(10, 2)
  currency        String          @default("BDT")
  billingInterval BillingInterval @default(MONTHLY)
  trialEligible   Boolean         @default(true)
  trialDays       Int             @default(7)
  entitlements    Json            // Array of enabled feature keys: string[]
  limits          Json            // Object map of usage limits: Record<string, number>
  status          PlanStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions   Subscription[]

  @@index([status])
  @@index([planType])
  @@map("plans")
}

// -----------------------------------------------------------------------------
// TENANT SUBSCRIPTION (Active Subscription & Trial Record)
// -----------------------------------------------------------------------------

model Subscription {
  id                    String             @id @default(cuid())
  tenantId              String             @unique
  planId                String
  subscriptionType      PlanType           @default(STARTER)
  status                SubscriptionStatus @default(TRIALING)
  trialStatus           TrialStatus        @default(NOT_STARTED)
  trialStartsAt         DateTime?
  trialEndsAt           DateTime?
  currentPeriodStartsAt DateTime?
  currentPeriodEndsAt   DateTime?
  cancelledAt           DateTime?
  priceLocked           Decimal            @db.Decimal(10, 2)
  currency              String             @default("BDT")
  billingInterval       BillingInterval    @default(MONTHLY)
  entitlements          Json?              // Custom entitlements or snapshot
  limits                Json?              // Custom usage limits or snapshot
  autoRenewConsent      Boolean            @default(false)
  autoRenewConsentAt    DateTime?
  approvedByUserId      String?
  approvedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan       Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  approvedBy User?                 @relation("ApprovedSubscriptions", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  invoices   SubscriptionInvoice[]

  @@index([status])
  @@index([trialStatus])
  @@index([planId])
  @@map("subscriptions")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTION INVOICE & BILLING RECORD
// -----------------------------------------------------------------------------

model SubscriptionInvoice {
  id                   String         @id @default(cuid())
  invoiceNumber        String         @unique
  subscriptionId       String
  tenantId             String
  amount               Decimal        @db.Decimal(10, 2)
  currency             String         @default("BDT")
  periodStart          DateTime
  periodEnd            DateTime
  dueDate              DateTime
  paidAt               DateTime?
  paymentStatus        PaymentStatus  @default(PENDING)
  paymentMethod        PaymentMethod?
  transactionReference String?
  confirmedByUserId    String?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  confirmedBy  User?        @relation("ConfirmedInvoices", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([paymentStatus])
  @@index([transactionReference])
  @@index([createdAt])
  @@map("subscription_invoices")
}

// -----------------------------------------------------------------------------
// CUSTOM BUSINESS PLAN INQUIRY
// -----------------------------------------------------------------------------

model CustomPlanInquiry {
  id                     String        @id @default(cuid())
  businessName           String
  businessCategory       String
  contactName            String
  contactEmail           String?
  contactPhone           String?
  propertyCount          Int           @default(1)
  estimatedMembers       Int           @default(10)
  requiredFeatures       Json          // string[]
  additionalRequirements String?
  status                 InquiryStatus @default(NEW)
  assignedToUserId       String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  assignedTo User?             @relation("AssignedInquiries", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  quotations CustomQuotation[]

  @@index([status])
  @@index([businessCategory])
  @@index([createdAt])
  @@map("custom_plan_inquiries")
}

// -----------------------------------------------------------------------------
// CUSTOM QUOTATION & PROPOSAL
// -----------------------------------------------------------------------------

model CustomQuotation {
  id                 String          @id @default(cuid())
  inquiryId          String
  tenantId           String?
  businessName       String
  propertyCount      Int
  estimatedMembers   Int
  monthlyPrice       Decimal         @db.Decimal(10, 2)
  currency           String          @default("BDT")
  billingInterval    BillingInterval @default(MONTHLY)
  includedFeatures   Json            // string[]
  usageLimits        Json            // Record<string, number>
  proposalValidUntil DateTime
  status             QuotationStatus @default(DRAFT)
  internalNotes      String?
  customerNotes      String?
  preparedByUserId   String?
  approvedByUserId   String?
  approvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  inquiry    CustomPlanInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  preparedBy User?             @relation("PreparedQuotations", fields: [preparedByUserId], references: [id], onDelete: SetNull)
  approvedBy User?             @relation("ApprovedQuotations", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([status])
  @@index([createdAt])
  @@map("custom_quotations")
}

// -----------------------------------------------------------------------------
// DOMAIN (Platform Subdomains & Custom Domains)
// -----------------------------------------------------------------------------

model Domain {
  id                       String                   @id @default(cuid())
  tenantId                 String
  domainName               String                   @unique
  domainType               DomainType               @default(PLATFORM_SUBDOMAIN)
  isPrimary                Boolean                  @default(false)
  verificationStatus       DomainVerificationStatus @default(NOT_REQUIRED)
  verificationToken        String?
  verificationExpiresAt    DateTime?
  verificationAttempts     Int                      @default(0)
  verificationFailedReason String?
  dnsStatus                DnsStatus                @default(PENDING_CONFIGURATION)
  sslStatus                SslStatus                @default(NOT_CONFIGURED)
  status                   DomainStatus             @default(ACTIVE)
  verifiedAt               DateTime?
  activatedAt              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([verificationStatus])
  @@index([domainType])
  @@map("domains")
}

// -----------------------------------------------------------------------------
// SUPPORT TICKETS & CONVERSATIONS
// -----------------------------------------------------------------------------

model SupportTicket {
  id              String                @id @default(cuid())
  ticketNumber    String                @unique @map("ticket_number")
  subject         String
  description     String?
  category        SupportTicketCategory @default(GENERAL_INQUIRY)
  priority        SupportTicketPriority @default(NORMAL)
  status          SupportTicketStatus   @default(NEW)
  requesterUserId String                @map("requester_user_id")
  tenantId        String?               @map("tenant_id")
  assignedStaffId String?               @map("assigned_staff_id")
  resolvedAt      DateTime?             @map("resolved_at")
  closedAt        DateTime?             @map("closed_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  requester     User                   @relation("RequesterTickets", fields: [requesterUserId], references: [id], onDelete: Restrict)
  assignedStaff User?                  @relation("AssignedTickets", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  tenant        Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  messages      SupportTicketMessage[]

  @@index([requesterUserId])
  @@index([tenantId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String   @id @default(cuid())
  ticketId     String   @map("ticket_id")
  authorUserId String   @map("author_user_id")
  message      String
  isInternal   Boolean  @default(false) @map("is_internal")
  attachments  Json?    @map("attachments")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([authorUserId])
  @@index([createdAt])
  @@map("support_ticket_messages")
}

// -----------------------------------------------------------------------------
// PLATFORM NOTIFICATIONS
// -----------------------------------------------------------------------------

model PlatformNotification {
  id        String           @id @default(cuid())
  userId    String?          @map("user_id")
  type      NotificationType @default(SYSTEM_ALERT)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("platform_notifications")
}

