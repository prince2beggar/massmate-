model FinancialCategory {
  id                  String         @id @default(cuid())
  tenantId            String         @map("tenant_id")
  name                String
  code                String
  description         String?
  allocationRule      AllocationRule @default(EQUAL_PER_MEMBER) @map("allocation_rule")
  defaultAmountPoisha BigInt?        @map("default_amount_poisha")
  isActive            Boolean        @default(true) @map("is_active")
  isSystem            Boolean        @default(false) @map("is_system")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billItems BillItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
  @@map("financial_categories")
}

model MonthlyBillingPeriod {
  id                   String              @id @default(cuid())
  tenantId             String              @map("tenant_id")
  monthString          String              @map("month_string") // "YYYY-MM"
  status               BillingPeriodStatus @default(DRAFT)
  totalBilledPoisha    BigInt              @default(0) @map("total_billed_poisha")
  totalCollectedPoisha BigInt              @default(0) @map("total_collected_poisha")
  notes                String?
  publishedAt          DateTime?           @map("published_at")
  closedAt             DateTime?           @map("closed_at")
  closedByUserId       String?             @map("closed_by_user_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closedByUser User?        @relation("ClosedBillingPeriods", fields: [closedByUserId], references: [id], onDelete: SetNull)
  memberBills  MemberBill[]

  @@unique([tenantId, monthString])
  @@index([tenantId])
  @@index([monthString])
  @@map("monthly_billing_periods")
}

model MemberBill {
  id                     String     @id @default(cuid())
  tenantId               String     @map("tenant_id")
  billingPeriodId        String     @map("billing_period_id")
  membershipId           String     @map("membership_id")
  monthString            String     @map("month_string") // "YYYY-MM"
  billNumber             String     @map("bill_number")
  openingDuePoisha       BigInt     @default(0) @map("opening_due_poisha")
  rentChargesPoisha      BigInt     @default(0) @map("rent_charges_poisha")
  utilityChargesPoisha   BigInt     @default(0) @map("utility_charges_poisha")
  mealChargesPoisha      BigInt     @default(0) @map("meal_charges_poisha")
  otherChargesPoisha     BigInt     @default(0) @map("other_charges_poisha")
  totalChargesPoisha     BigInt     @default(0) @map("total_charges_poisha")
  paidAmountPoisha       BigInt     @default(0) @map("paid_amount_poisha")
  creditAdjustmentPoisha BigInt     @default(0) @map("credit_adjustment_poisha")
  closingBalancePoisha   BigInt     @default(0) @map("closing_balance_poisha")
  status                 BillStatus @default(DRAFT)
  dueDate                String?    @map("due_date")
  publishedAt            DateTime?  @map("published_at")
  notes                  String?
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingPeriod MonthlyBillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  membership    Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  items         BillItem[]
  payments      MemberPayment[]
  adjustments   BalanceAdjustment[]

  @@unique([tenantId, billingPeriodId, membershipId])
  @@index([tenantId])
  @@index([membershipId])
  @@index([status])
  @@map("member_bills")
}

model BillItem {
  id             String         @id @default(cuid())
  billId         String         @map("bill_id")
  categoryId     String?        @map("category_id")
  categoryName   String         @map("category_name")
  amountPoisha   BigInt         @map("amount_poisha")
  allocationRule AllocationRule @default(EQUAL_PER_MEMBER) @map("allocation_rule")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  bill     MemberBill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  category FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@map("bill_items")
}

model MemberPayment {
  id               String              @id @default(cuid())
  tenantId         String              @map("tenant_id")
  membershipId     String              @map("membership_id")
  billId           String?             @map("bill_id")
  paymentDate      String              @map("payment_date") // "YYYY-MM-DD"
  amountPoisha     BigInt              @map("amount_poisha")
  paymentMethod    PaymentMethod       @default(CASH) @map("payment_method")
  transactionId    String?             @map("transaction_id")
  receiptUrl       String?             @map("receipt_url")
  notes            String?
  status           MemberPaymentStatus @default(PENDING)
  receivedByUserId String?             @map("received_by_user_id")
  verifiedByUserId String?             @map("verified_by_user_id")
  verifiedAt       DateTime?           @map("verified_at")
  rejectionReason  String?             @map("rejection_reason")
  refundReason     String?             @map("refund_reason")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership     Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  bill           MemberBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  receivedByUser User?       @relation("ReceivedMemberPayments", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  verifiedByUser User?       @relation("VerifiedMemberPayments", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([membershipId])
  @@index([billId])
  @@index([status])
  @@index([transactionId])
  @@map("member_payments")
}

model BalanceAdjustment {
  id                 String         @id @default(cuid())
  tenantId           String         @map("tenant_id")
  membershipId       String         @map("membership_id")
  billId             String?        @map("bill_id")
  amountPoisha       BigInt         @map("amount_poisha")
  type               AdjustmentType @default(CREDIT)
  reason             String
  authorizedByUserId String?        @map("authorized_by_user_id")
  createdAt          DateTime       @default(now()) @map("created_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership       Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  bill             MemberBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  authorizedByUser User?       @relation("AuthorizedAdjustments", fields: [authorizedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([membershipId])
  @@index([billId])
  @@map("balance_adjustments")
}

// -----------------------------------------------------------------------------
// MESS SETTINGS & PREFERENCES (Task 36)
// -----------------------------------------------------------------------------

model MessSetting {
  id                         String   @id @default(cuid())
  tenantId                   String   @unique @map("tenant_id")
  preferredLanguage          String   @default("en") @map("preferred_language") // 'en' | 'bn'
  contactPhone               String?  @map("contact_phone")
  contactEmail               String?  @map("contact_email")
  address                    String?
  city                       String?
  timezone                   String   @default("Asia/Dhaka")
  themeColor                 String   @default("emerald") @map("theme_color")
  publicWebsiteEnabled       Boolean  @default(true) @map("public_website_enabled")
  showMenuOnHomepage         Boolean  @default(true) @map("show_menu_on_homepage")
  customTagline              String?  @map("custom_tagline")
  defaultBillingPeriod       String   @default("CALENDAR_MONTH") @map("default_billing_period")
  currency                   String   @default("BDT")
  enableRentalModule         Boolean  @default(true) @map("enable_rental_module")
  enableMealModule           Boolean  @default(true) @map("enable_meal_module")
  enableBazarModule          Boolean  @default(true) @map("enable_bazar_module")
  notifyOnNewExpense         Boolean  @default(true) @map("notify_on_new_expense")
  notifyOnPaymentReceived    Boolean  @default(true) @map("notify_on_payment_received")
  notifyOnMealCutoff         Boolean  @default(true) @map("notify_on_meal_cutoff")
  memberDirectoryVisibility  String   @default("MEMBERS_ONLY") @map("member_directory_visibility")
  contactVisibility          String   @default("PUBLIC") @map("contact_visibility")
  rentalVisibility           String   @default("PUBLIC") @map("rental_visibility")
  emergencyContactVisibility String   @default("ADMINS_ONLY") @map("emergency_contact_visibility")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("mess_settings")
}

// -----------------------------------------------------------------------------
// MESS NOTICES & ANNOUNCEMENTS (Task 37 & 39)
// -----------------------------------------------------------------------------

model Notice {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  title        String
  content      String
  category     String    @default("GENERAL") // GENERAL, DINING, MAINTENANCE, FINANCE, EMERGENCY
  priority     String    @default("NORMAL")  // LOW, NORMAL, HIGH, URGENT
  isPinned     Boolean   @default(false)     @map("is_pinned")
  status       String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  authorUserId String?   @map("author_user_id")
  publishedAt  DateTime? @map("published_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now())      @map("created_at")
  updatedAt    DateTime  @updatedAt          @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorUser User?  @relation("AuthoredNotices", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([isPinned])
  @@map("notices")
}

// -----------------------------------------------------------------------------
// MEMBER PERSONAL REQUESTS (Task 38)
// -----------------------------------------------------------------------------

model MemberRequest {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  membershipId     String    @map("membership_id")
  requestType      String    @map("request_type") // ROOM_CHANGE, PROFILE_UPDATE, MAINTENANCE, GENERAL_QUERY
  title            String
  description      String
  requestedRoomId  String?   @map("requested_room_id")
  preferredDate    DateTime? @map("preferred_date")
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  adminResponse    String?   @map("admin_response")
  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")
  metadata         Json?     // Proposed profile/emergency contact updates, custom parameters
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  requestedRoom Room?      @relation("RequestedRoom", fields: [requestedRoomId], references: [id], onDelete: SetNull)
  reviewer      User?      @relation("ReviewedMemberRequests", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([membershipId])
  @@index([status])
  @@map("member_requests")
}




